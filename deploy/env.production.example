# Plantilla del .env de producción. deploy/deploy.sh la copia a /var/www/casaronald/.env
# sustituyendo __APP_HOST__, __DB_PASSWORD__ y __MASTER_PASSWORD__ y genera APP_KEY.
APP_NAME="Casa Ronald"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__APP_HOST__
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MariaDB por socket local (más rápido que TCP y sin exponer puertos)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=/var/lib/mysql/mysql.sock
DB_DATABASE=casaronald
DB_USERNAME=casaronald
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# La aplicación no encola trabajos; con "sync" no hace falta un worker.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@casaronald.local"
MAIL_FROM_NAME="${APP_NAME}"

# Cuenta maestra: la usa el seeder la primera vez (y cada vez que se vuelva a sembrar)
MASTER_NAME="Administración Casa Ronald"
MASTER_EMAIL=master@casaronald.local
MASTER_PASSWORD=__MASTER_PASSWORD__
